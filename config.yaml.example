# Movie Analysis System Configuration

# Ollama Configuration
ollama:
  host: http://localhost:11434
  model: deepseek-r1:8b
  temperature: 0.7

# Video Processing
video:
  scene_threshold: 27.0        # Lower = more sensitive scene detection
  keyframes_per_scene: 1       # Number of keyframes to extract per scene
  keyframe_method: middle      # Options: first, middle, last, distributed, variance
  max_resolution: 1920         # Maximum width for frames (maintains aspect ratio)

# Audio & Transcription
audio:
  whisper_model: base          # Options: tiny, base, small, medium, large
  language: null               # null for auto-detection, or specify language code (e.g., 'en')
  sample_rate: 16000           # Audio sample rate for transcription

# Storyboard
storyboard:
  format: pdf                  # Options: pdf, html, image
  columns: 3                   # Number of columns in grid layout
  include_captions: true       # Include AI-generated captions

# Analysis Options
analysis:
  generate_summary: true       # Generate movie summary
  analyze_scenes: true         # Analyze individual scenes
  scriptwriting_analysis: true # Perform scriptwriting analysis
  identify_themes: true        # Identify themes
  character_analysis: false    # Detailed character analysis (slow)

# Output
output:
  directory: ./output
  save_frames: true
  save_audio: true
  formats:
    - json
    - markdown
    - pdf
